{
  "name": "turntable",
  "version": "1.1.0",
  "description": "A glass-styled music player for your own audio files.",
  "author": "Turntable <turntable@example.com>",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.turntable.player",
    "productName": "Turntable",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": [
          "mp3",
          "m4a",
          "wav",
          "ogg",
          "opus",
          "flac",
          "aac"
        ],
        "name": "Audio file",
        "role": "Viewer"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "Turntable-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.music",
      "artifactName": "Turntable-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Audio",
      "artifactName": "Turntable-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Turntable-Portable-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "github.com/bossredemption24-svg",
        "repo": "turntable",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}
